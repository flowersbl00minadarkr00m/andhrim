# Safe default: deterministic local fixture with no provider access.
AGENT_OR_NOT_PROVIDER_MODE=fixture

# Loopback-only Pydantic/FastMCP companion. The launcher supplies the URL.
AGENT_OR_NOT_MEMORY_MCP_PORT=4275

# Fill both values manually, or use System -> Configure OpenRouter in the local UI.
OPENROUTER_MODEL=
OPENROUTER_API_KEY=
